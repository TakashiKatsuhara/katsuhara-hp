      <a href="recruit/#benefits" class="ritem fade"><div class="ritem-l"><span class="rn">03</span><span class="rt">制度・福利厚生</span></div><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 7h10M7 3l4 4-4 4"/></svg></a>
      <a href="recruit/#interview" class="ritem fade"><div class="ritem-l"><span class="rn">04</span><span class="rt">先輩社員インタビュー</span></div><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 7h10M7 3l4 4-4 4"/></svg></a>
      <a href="recruit/#requirements" class="ritem fade"><div class="ritem-l"><span class="rn">05</span><span class="rt">募集要項</span></div><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 7h10M7 3l4 4-4 4"/></svg></a>
    </div>
    <div class="rcta fade">
