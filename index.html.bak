<!-- RECRUIT -->
<section class="recruit" id="recruit">
  <div class="rphoto">
    <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=1200&q=80" alt="勝原製作所の職場">
  </div>
  <div class="rbody">
    <span class="s-label fade">Recruit</span>
    <h2 class="s-title fade">ともに挑戦する<br><strong>仲間を探しています。</strong></h2>
    <p class="s-desc fade">年功序列ではなく、提案と挑戦を評価する場所。製造業の常識にとらわれない発想と行動力を求めています。</p>
    <div class="rlist">
      <a href="recruit/#data" class="ritem fade"><div class="ritem-l"><span class="rn">01</span><span class="rt">データで見る勝原製作所</span></div><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 7h10M7 3l4 4-4 4"/></svg></a>
